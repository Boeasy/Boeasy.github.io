{% comment %}
Include file to display research notes related to a project
Usage: {% include research_notes.liquid project_title="Project Title" %}
{% endcomment %}

{% assign project_title = include.project_title | default: page.title %}
{% assign related_notes = site.research_notes | where: "related_project", project_title %}

{% if related_notes.size > 0 %}
<div class="research-notes-section mt-5">
  <h2>Related Research Notes</h2>
  <p class="text-muted">Notes and observations from this project:</p>
  
  <div class="row">
    {% for note in related_notes %}
      <div class="col-md-6 mb-3">
        <div class="card h-100">
          <div class="card-body">
            <h5 class="card-title">
              <a href="{{ note.url | relative_url }}" class="text-decoration-none">{{ note.title }}</a>
            </h5>
            <p class="card-text">{{ note.description }}</p>
            <div class="card-footer bg-transparent">
              <small class="text-muted">
                <i class="fa-solid fa-calendar fa-sm"></i> {{ note.date | date: '%B %d, %Y' }}
                {% if note.tags.size > 0 %}
                  &nbsp; &middot; &nbsp;
                  {% for tag in note.tags limit: 3 %}
                    <span class="badge badge-secondary">{{ tag }}</span>
                  {% endfor %}
                {% endif %}
              </small>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
  
  <div class="text-center mt-3">
    <a href="{{ '/research-notes/' | relative_url }}" class="btn btn-outline-primary">
      <i class="fa-solid fa-arrow-right"></i> View All Research Notes
    </a>
  </div>
</div>
{% endif %}
